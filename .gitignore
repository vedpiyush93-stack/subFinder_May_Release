# =============================================================================
# subFinder release — git ignore rules (push-ready)
# =============================================================================
#
# Anything excluded here is distributed via Google Drive zips. See README §5
# for download links and where to extract.
# Comments must be on their own line — inline comments break gitignore patterns.

# ---------------------------------------------------------------------------
# Heavy artifacts — distributed via subfinder_final_model.zip
# ---------------------------------------------------------------------------
# 176 MB (exceeds GitHub's 100 MB hard limit)
artifacts/final_model.pkl
# ~85 KB each, bundled with final_model.zip
artifacts/calibration/*.npz
artifacts/calibration/*.json

# ---------------------------------------------------------------------------
# Heavy classifier weights — distributed via subfinder_classifier_weights.zip
# 25 × ~45 MB = ~1.1 GB for joblib, same again for keras
# ---------------------------------------------------------------------------
artifacts/predictions/*/r*_f*/classifier.joblib
artifacts/predictions/*/r*_f*/classifier.keras

# ---------------------------------------------------------------------------
# Embedding cache — NOT shipped. ~255 GB raw. Reviewers regenerate locally via
#   python3 scripts/01_train_embeddings.py --retrain    (~6 h on M4 Max)
# Only needed for the 7 BRF+embedding shallow configs and the 20 DL configs.
# The top model (cpu__ET500_log2) uses NO embeddings — headline results are
# fully reproducible without this cache. See README §5 Tier B.
# ---------------------------------------------------------------------------
artifacts/embeddings_cache
artifacts/embeddings_cache/

# ---------------------------------------------------------------------------
# Python / build noise
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
.pytest_cache/
.venv/
.DS_Store
*.egg-info/

# ---------------------------------------------------------------------------
# Jupyter / LaTeX noise
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.toc
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls
paper/*.out

# ---------------------------------------------------------------------------
# Release zips themselves (these live OUTSIDE the repo at /Users/ved/release_zips/)
# but listed here so they're never accidentally committed if someone moves them in
# ---------------------------------------------------------------------------
*.zip
release_zips/
